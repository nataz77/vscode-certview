{
  "name": "certview",
  "displayName": "CertView",
  "description": "Inspect X.509 certificates from .crt, .pem and .pfx files and Kubernetes TLS Secret YAML files, with full CA chain display and system trust validation.",
  "version": "0.1.0",
  "publisher": "local",
  "repository": "https://github.com/nataz77/vscode-k8scert",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:certview.showCertificate"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "certview.showCertificate",
        "title": "CertView: Show Certificate Details",
        "icon": "$(key)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "certview.showCertificate",
          "when": "resourceLangId == yaml || resourceExtname =~ /^\\.(crt|cer|pem|pfx|p12)$/i",
          "group": "navigation@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "certview.showCertificate",
          "when": "resourceLangId == yaml || resourceExtname =~ /^\\.(crt|cer|pem|pfx|p12)$/i",
          "group": "navigation@99"
        }
      ],
      "editor/context": [
        {
          "command": "certview.showCertificate",
          "when": "resourceLangId == yaml || resourceExtname =~ /^\\.(crt|cer|pem|pfx|p12)$/i",
          "group": "navigation@99"
        }
      ],
      "explorer/context": [
        {
          "command": "certview.showCertificate",
          "when": "resourceLangId == yaml || resourceExtname =~ /^\\.(crt|cer|pem|pfx|p12)$/i",
          "group": "navigation@99"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p . && esbuild webview/main.ts --bundle --format=iife --platform=browser --target=chrome102 --outfile=out/webview.js",
    "test": "npm run compile && node --test out/test/*.test.js"
  },
  "dependencies": {
    "@fluentui/tokens": "^1.0.0-alpha.24",
    "@fluentui/web-components": "^3.1.3",
    "node-forge": "^1.4.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/node-forge": "^1.3.14",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.4"
  }
}
